# Plantilla de variables de entorno del Portal Comité de Ética.
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# Atajo: `npx vercel env pull .env.local` descarga los valores desde Vercel.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=          # URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Clave pública (anon)
SUPABASE_SERVICE_ROLE_KEY=         # Clave service_role (solo servidor, secreta)
SUPABASE_DB_PASSWORD=              # Contraseña de la base; la usa /api/admin/migrate

# --- Acceso de revisores ---
REVIEWER_PASSWORD=                 # Clave de ingreso al panel de revisores
REVIEWER_SESSION_TOKEN=            # Token secreto de sesión (string largo aleatorio)
CERT_SECRET=                       # Secreto para firmar certificados (string largo aleatorio)

# --- Correo (Gmail) ---
EMAIL_USER=                        # Cuenta Gmail que envía las notificaciones
EMAIL_PASS=                        # Contraseña de aplicación de Gmail (no la clave normal)
COORDINATOR_EMAIL=                 # Email de la coordinación del comité
MACARENA_EMAIL=                    # Email de Macarena Cárdenas (avisos y certificados)

# --- Google Drive (adjuntos) ---
GOOGLE_DRIVE_FOLDER_ID=            # ID de la carpeta de Drive donde se guardan documentos
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- IA ---
GEMINI_API_KEY=                    # Clave de Google Gemini para la revisión asistida
